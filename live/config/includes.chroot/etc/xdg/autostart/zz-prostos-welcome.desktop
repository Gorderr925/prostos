[Desktop Entry]
Type=Application
Version=1.0
Name=ProstOS Welcome
Name[ru]=Знакомство с ProstOS
Comment=Offer to install ProstOS
Comment[ru]=Предложить установить ProstOS
Exec=/usr/bin/prostos-welcome
Icon=prostos
Terminal=false
NoDisplay=true
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
