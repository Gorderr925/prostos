#!/bin/sh
# Put the ProstOS launchers on the user's desktop and mark them trusted for XFCE.
set -u

# Let xdg-user-dirs create the (localized) folders first, otherwise the Russian
# locale gives "Рабочий стол" and our icons would land in an invisible "Desktop".
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update >/dev/null 2>&1 || true
i=0
while [ ! -f "$HOME/.config/user-dirs.dirs" ] && [ "$i" -lt 15 ]; do
	sleep 1
	i=$((i + 1))
done
sleep 1

desktop_dir="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
if [ -z "$desktop_dir" ] || [ "$desktop_dir" = "$HOME" ]; then
	desktop_dir="$HOME/Рабочий стол"
fi
mkdir -p "$desktop_dir" 2>/dev/null || exit 0

for app in prostos-install prostos-welcome; do
	src="/usr/share/applications/$app.desktop"
	dst="$desktop_dir/$app.desktop"
	[ -f "$src" ] || continue

	cp -f "$src" "$dst" 2>/dev/null || continue
	chmod 755 "$dst" 2>/dev/null || true

	if command -v gio >/dev/null 2>&1; then
		gio set --type=string "$dst" metadata::trusted true 2>/dev/null || true
		sum="$(sha256sum "$dst" 2>/dev/null | cut -f1 -d' ')"
		[ -n "$sum" ] && gio set --type=string "$dst" metadata::xfce-exe-checksum "$sum" 2>/dev/null || true
		touch "$dst" 2>/dev/null || true
	fi
done

exit 0
