# ProstOS 4.0 — экран загрузки.
# Логотип по центру, под ним три пульсирующие точки.

Window.SetBackgroundTopColor (0.016, 0.071, 0.051);
Window.SetBackgroundBottomColor (0.043, 0.141, 0.098);

splash_image = Image ("splash.png");
splash_sprite = Sprite (splash_image);
splash_sprite.SetX (Window.GetWidth () / 2 - splash_image.GetWidth () / 2);
splash_sprite.SetY (Window.GetHeight () / 2 - splash_image.GetHeight () / 2);

dot_image = Image ("dot.png");
dot1 = Sprite (dot_image);
dot2 = Sprite (dot_image);
dot3 = Sprite (dot_image);

dot_y = Window.GetHeight () / 2 + splash_image.GetHeight () / 2 + 34;
dot_gap = 26;
dot_cx = Window.GetWidth () / 2;

dot1.SetX (dot_cx - dot_gap - dot_image.GetWidth () / 2);
dot2.SetX (dot_cx - dot_image.GetWidth () / 2);
dot3.SetX (dot_cx + dot_gap - dot_image.GetWidth () / 2);

dot1.SetY (dot_y);
dot2.SetY (dot_y);
dot3.SetY (dot_y);

dot1.SetZ (10);
dot2.SetZ (10);
dot3.SetZ (10);

frame = 0;
phase = 0;

fun refresh_callback ()
{
  frame++;

  # медленная смена фаз: 0, 1, 2
  if (frame % 18 == 0)
    phase = (phase + 1) % 3;

  if (phase == 0)
    {
      dot1.SetOpacity (1.0);
      dot2.SetOpacity (0.25);
      dot3.SetOpacity (0.25);
    }
  if (phase == 1)
    {
      dot1.SetOpacity (0.25);
      dot2.SetOpacity (1.0);
      dot3.SetOpacity (0.25);
    }
  if (phase == 2)
    {
      dot1.SetOpacity (0.25);
      dot2.SetOpacity (0.25);
      dot3.SetOpacity (1.0);
    }
}

Plymouth.SetRefreshFunction (refresh_callback);
