#!/bin/sh
set -eu

export DEBIAN_FRONTEND=noninteractive

# --- Locale ---
sed -i -E 's/^# *ru_RU\.UTF-8 UTF-8/ru_RU.UTF-8 UTF-8/' /etc/locale.gen
sed -i -E 's/^# *en_US\.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
update-locale LANG=ru_RU.UTF-8 LANGUAGE=ru_RU:ru

# --- Timezone ---
ln -sf /usr/share/zoneinfo/Europe/Moscow /etc/localtime
printf '%s\n' 'Europe/Moscow' > /etc/timezone

# --- Keyboard ---
cat > /etc/default/keyboard <<'EOF'
XKBMODEL="pc105"
XKBLAYOUT="ru,us"
XKBVARIANT=""
XKBOPTIONS="grp:alt_shift_toggle"
BACKSPACE="guess"
EOF

# --- LightDM: autologin for the live session ---
mkdir -p /etc/lightdm/lightdm.conf.d
cat > /etc/lightdm/lightdm.conf.d/50-prostos.conf <<'EOF'
[Seat:*]
autologin-user=prost
autologin-user-timeout=0
autologin-session=xfce
greeter-session=lightdm-gtk-greeter
user-session=xfce
EOF

# --- Services ---
systemctl enable lightdm.service 2>/dev/null || true
systemctl enable NetworkManager.service 2>/dev/null || true
systemctl set-default graphical.target 2>/dev/null || true

# --- Machine identity (regenerated at boot) ---
rm -f /etc/machine-id /var/lib/dbus/machine-id
touch /etc/machine-id

# --- Permissions ---
chmod 755 /usr/bin/prostos-wallpaper 2>/dev/null || true
chmod 755 /usr/bin/prostos-install 2>/dev/null || true
chmod 755 /usr/bin/prostos-desktop-icons 2>/dev/null || true
chmod 644 /etc/xdg/autostart/prostos-wallpaper.desktop 2>/dev/null || true
chmod 644 /etc/xdg/autostart/zz-prostos-desktop-icons.desktop 2>/dev/null || true
chmod 644 /usr/share/applications/prostos-welcome.desktop 2>/dev/null || true
chmod 644 /usr/share/applications/prostos-install.desktop 2>/dev/null || true
chmod 440 /etc/sudoers.d/010-prostos-live 2>/dev/null || true
chmod 644 /etc/polkit-1/rules.d/49-prostos-calamares.rules 2>/dev/null || true
chmod 755 /usr/bin/prostos-welcome 2>/dev/null || true
chmod 644 /etc/xdg/autostart/zz-prostos-welcome.desktop 2>/dev/null || true
chmod 755 /usr/bin/prostos-apps 2>/dev/null || true
chmod 755 /usr/bin/prostos-user-setup 2>/dev/null || true
chmod 644 /etc/xdg/autostart/prostos-apps-offer.desktop 2>/dev/null || true
chmod 644 /etc/xdg/autostart/prostos-user-setup.desktop 2>/dev/null || true
chmod 644 /usr/share/applications/prostos-apps.desktop 2>/dev/null || true
chmod 755 /usr/bin/prostos-postinstall 2>/dev/null || true
chmod 755 /usr/bin/prostos-apps-offer 2>/dev/null || true

# --- Уборка после установки на диск (один раз при первой загрузке) ---
systemctl enable prostos-postinstall.service 2>/dev/null || true
chmod 644 /etc/systemd/system/prostos-postinstall.service 2>/dev/null || true

# --- Multiarch: 32-битные программы Windows ---
if ! dpkg --print-foreign-architectures 2>/dev/null | grep -qx i386; then
	dpkg --add-architecture i386
fi
apt-get update || true
apt-get install -y --no-install-recommends wine32:i386 || echo "wine32:i386: пропущено"

# --- Flathub: приложения в один клик ---
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true

# --- Обои в PNG: надёжнее на старых видеокартах и в greeter ---
if command -v rsvg-convert >/dev/null 2>&1 && [ -f /usr/share/backgrounds/prostos/wallpaper.svg ]; then
	rsvg-convert -w 1920 -h 1080 /usr/share/backgrounds/prostos/wallpaper.svg \
		-o /usr/share/backgrounds/prostos/wallpaper.png 2>/dev/null || true
fi

# --- Имя системы вместо «Debian live user» ---
usermod -c "ProstOS" prost 2>/dev/null || true
mkdir -p /var/lib/AccountsService/users
cat > /var/lib/AccountsService/users/prost <<'EOF'
[User]
Language=ru_RU.UTF-8
XSession=xfce
SystemAccount=false
Name=ProstOS
Icon=/usr/share/icons/hicolor/scalable/apps/prostos.svg
EOF
chmod 600 /var/lib/AccountsService/users/prost 2>/dev/null || true

# --- Desktop caches ---
update-desktop-database /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true

exit 0
