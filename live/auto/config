#!/bin/sh
set -eu

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--archive-areas "main contrib non-free non-free-firmware" \
	--debian-installer none \
	--debconf-frontend noninteractive \
	--debconf-priority critical \
	--bootappend-live "boot=live components quiet splash locales=ru_RU.UTF-8 keyboard-layouts=ru,us keyboard-options=grp:alt_shift_toggle timezone=Europe/Moscow username=prost hostname=prostos persistence" \
	--bootloaders "syslinux,grub-efi" \
	--iso-application "ProstOS" \
	--iso-preparer "ProstOS Project" \
	--iso-publisher "ProstOS Project" \
	--iso-volume "PROSTOS" \
	--image-name "prostos" \
	--memtest none \
	--apt-indices false \
	--checksums sha256 \
	--compression xz \
	--chroot-squashfs-compression-type zstd \
	--firmware-chroot true
